<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime permissions for folio, folio-cli and folio-mcp. Plugins are native libraries
     (../lsuite/PLUGINS.md) that other developers, or the person's own agent, sign: library
     validation is off so they load. GPUI itself needs no runtime exception. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
